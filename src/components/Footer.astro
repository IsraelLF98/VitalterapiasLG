---
// Obtiene el año actual (ej. 2026) para mostrarlo en el copyright
// de forma automática, sin tener que actualizarlo cada año.
const currentYear = new Date().getFullYear();

// Enlaces de navegación reutilizados en el footer (mismos destinos que el menú).
// En el HTML se recorren con navLinks.map() para generar cada <li>.
const navLinks = [
  { label: 'Inicio', href: '#inicio' },
  { label: 'Nosotros', href: '#nosotros' },
  { label: 'Beneficios', href: '#beneficios' },
  { label: 'Proceso', href: '#proceso' },
  { label: 'FAQ', href: '#faq' },
  { label: 'Contacto', href: '#contacto' },
];
---

<footer class="footer">
  <div class="container">
    <!-- Grid de 3 columnas: marca (1), navegación (2) y contacto (3) -->
    <div class="footer__grid">
      <!-- Columna 1: logo, descripción y redes sociales -->
      <div class="footer__brand">
        <a href="#inicio" class="footer__logo">
          Vital<span>Terapias</span> LG🍊💉
        </a>
        <p class="footer__tagline">
          Terapia de Vitamina C intravenosa para fortalecer tu sistema inmunológico
          y mejorar tu calidad de vida.
        </p>
        <!-- Iconos circulares de redes sociales (WhatsApp y email) -->
        <div class="footer__social">
          <a href="https://wa.me/593996637117" target="_blank" rel="noopener noreferrer" aria-label="WhatsApp" class="footer__social-link">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          </a>
          <a href="mailto:gatolic1@outlook.com" aria-label="Email" class="footer__social-link">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
          </a>
        </div>
      </div>

      <!-- Columna 2: enlaces de navegación generados con .map() -->
      <div class="footer__links">
        <h4 class="footer__heading">Navegación</h4>
        <ul class="footer__link-list">
          {navLinks.map((link) => (
            <li>
              <a href={link.href} class="footer__link">{link.label}</a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Columna 3: datos de contacto (teléfono, email, horarios) -->
      <div class="footer__contact-info">
        <h4 class="footer__heading">Contacto</h4>
        <ul class="footer__contact-list">
          <li>
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
            <span>+593 99 663 7117</span>
          </li>
          <li>
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
            <span>gatolic1@outlook.com</span>
          </li>
          <li>
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
            <span>Lun - Dom: Previo agendamiento</span>
          </li>
        </ul>
      </div>
    </div>

    <!-- Barra inferior con el copyright; el año se inserta desde la variable currentYear -->
    <div class="footer__bottom">
      <p>&copy; {currentYear} VitalTerapias LG — Todos los derechos reservados</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--color-dark);
    padding: var(--space-4xl) 0 0;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
  }

  /* Grid de 3 columnas: la marca es 1.5 veces más ancha que las otras dos */
  .footer__grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr;
    gap: var(--space-3xl);
    padding-bottom: var(--space-3xl);
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .footer__logo {
    display: inline-block;
    font-family: var(--font-heading);
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--color-white);
    margin-bottom: var(--space-md);
  }

  .footer__logo span {
    background: linear-gradient(135deg, var(--color-primary), var(--color-accent));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .footer__tagline {
    font-size: 0.9rem;
    color: var(--color-gray-500);
    line-height: 1.7;
    margin-bottom: var(--space-lg);
    max-width: 320px;
  }

  .footer__social {
    display: flex;
    gap: var(--space-md);
  }

  /* Enlaces sociales: círculos de 40px; al pasar el cursor se rellenan
     de primario, el icono se vuelve blanco y se elevan 3px */
  .footer__social-link {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.06);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-gray-400);
    transition: all var(--transition-base);
  }

  .footer__social-link:hover {
    background: var(--color-primary);
    color: var(--color-white);
    transform: translateY(-3px);
  }

  .footer__heading {
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-white);
    margin-bottom: var(--space-lg);
    font-family: var(--font-heading);
  }

  .footer__link-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .footer__link {
    font-size: 0.9rem;
    color: var(--color-gray-500);
    transition: all var(--transition-fast);
    padding: 0.2rem 0;
    display: inline-block;
  }

  /* Al hacer hover el enlace se aclara y se desplaza 4px a la derecha */
  .footer__link:hover {
    color: var(--color-primary-light);
    transform: translateX(4px);
  }

  .footer__contact-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .footer__contact-list li {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    font-size: 0.9rem;
    color: var(--color-gray-500);
  }

  .footer__bottom {
    padding: var(--space-xl) 0;
    text-align: center;
  }

  .footer__bottom p {
    font-size: 0.85rem;
    color: var(--color-gray-600);
  }

  /* Responsivo */
  /* En móvil el footer se apila en 1 columna y todo el contenido se centra */
  @media (max-width: 768px) {
    .footer__grid {
      grid-template-columns: 1fr;
      gap: var(--space-2xl);
      text-align: center;
    }

    .footer__tagline {
      max-width: 100%;
    }

    .footer__social {
      justify-content: center;
    }

    .footer__link-list {
      align-items: center;
    }

    .footer__contact-list li {
      justify-content: center;
    }
  }
</style>
