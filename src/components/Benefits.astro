---
const benefits = [
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>`,
    title: 'Refuerza el sistema inmune',
    description: 'Estimula la producción de glóbulos blancos y anticuerpos, creando una barrera natural contra virus, bacterias e infecciones estacionales.',
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>`,
    title: 'Aumenta la energía',
    description: 'Reduce significativamente la fatiga crónica y el agotamiento, mejorando tu rendimiento físico y mental de forma notable.',
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="16"></line><line x1="8" y1="12" x2="16" y2="12"></line></svg>`,
    title: 'Antioxidante potente',
    description: 'Neutraliza los radicales libres y protege tus células del daño oxidativo, retrasando el envejecimiento celular prematuro.',
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>`,
    title: 'Mejora la piel',
    description: 'Estimula la producción natural de colágeno, mejorando la elasticidad, luminosidad e hidratación de tu piel desde el interior.',
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 12h-4l-3 9L9 3l-3 9H2"></path></svg>`,
    title: 'Recuperación acelerada',
    description: 'Acelera la recuperación post-operatoria, deportiva y de enfermedades, reduciendo tiempos de convalecencia significativamente.',
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>`,
    title: 'Reduce la inflamación',
    description: 'Posee propiedades antiinflamatorias que ayudan a reducir el dolor articular, muscular y los procesos inflamatorios crónicos.',
  },
];
---

<section id="beneficios" class="section section-dark">
  <div class="container">
    <div class="section-header reveal">
      <span class="section-badge">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
        Beneficios
      </span>
      <h2>¿Por qué elegir <span class="gradient-text">Vitamina C IV</span>?</h2>
      <p>Descubre cómo esta terapia puede transformar tu bienestar y calidad de vida</p>
    </div>

    <div class="benefits__grid reveal-stagger">
      {benefits.map((benefit) => (
        <div class="benefit-card">
          <div class="benefit-card__icon">
            <Fragment set:html={benefit.icon} />
          </div>
          <h3 class="benefit-card__title">{benefit.title}</h3>
          <p class="benefit-card__description">{benefit.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .benefits__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-xl);
  }

  .benefit-card {
    position: relative;
    padding: var(--space-2xl);
    border-radius: var(--radius-xl);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.06);
    transition: all var(--transition-base);
    overflow: hidden;
  }

  .benefit-card::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: linear-gradient(135deg, rgba(245, 158, 11, 0.08), transparent 60%);
    opacity: 0;
    transition: opacity var(--transition-base);
  }

  .benefit-card:hover {
    transform: translateY(-8px);
    border-color: rgba(245, 158, 11, 0.2);
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
  }

  .benefit-card:hover::before {
    opacity: 1;
  }

  .benefit-card__icon {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 60px;
    height: 60px;
    border-radius: var(--radius-lg);
    background: linear-gradient(135deg, rgba(245, 158, 11, 0.15), rgba(249, 115, 22, 0.1));
    color: var(--color-primary-light);
    margin-bottom: var(--space-lg);
    transition: all var(--transition-base);
  }

  .benefit-card:hover .benefit-card__icon {
    background: linear-gradient(135deg, var(--color-primary), var(--color-accent));
    color: var(--color-white);
    transform: scale(1.1);
    box-shadow: 0 8px 24px var(--color-primary-glow);
  }

  .benefit-card__title {
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--color-white);
    margin-bottom: var(--space-md);
    position: relative;
  }

  .benefit-card__description {
    font-size: 0.95rem;
    color: var(--color-gray-400);
    line-height: 1.7;
    position: relative;
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .benefits__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .benefits__grid {
      grid-template-columns: 1fr;
    }

    .benefit-card {
      padding: var(--space-xl);
    }
  }
</style>
