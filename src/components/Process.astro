---
const steps = [
  {
    number: '01',
    title: 'Consulta Inicial',
    description: 'Evaluamos tu estado de salud, historial médico y objetivos para personalizar tu tratamiento de Vitamina C.',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="8.5" cy="7" r="4"></circle><line x1="20" y1="8" x2="20" y2="14"></line><line x1="23" y1="11" x2="17" y2="11"></line></svg>`,
  },
  {
    number: '02',
    title: 'Preparación',
    description: 'Preparamos la dosis óptima de Vitamina C según tus necesidades individuales en un ambiente cómodo y estéril.',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path></svg>`,
  },
  {
    number: '03',
    title: 'Aplicación IV',
    description: 'Administramos la terapia vía intravenosa en una sesión de 30-45 minutos, supervisada por profesionales certificados.',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 12h-4l-3 9L9 3l-3 9H2"></path></svg>`,
  },
  {
    number: '04',
    title: 'Seguimiento',
    description: 'Monitoreamos tu respuesta al tratamiento y ajustamos el plan según tu evolución para resultados óptimos.',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>`,
  },
];
---

<section id="proceso" class="section">
  <div class="container">
    <div class="section-header reveal">
      <span class="section-badge">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline></svg>
        Proceso
      </span>
      <h2>¿Cómo <span class="gradient-text">funciona</span>?</h2>
      <p>Un proceso simple, seguro y supervisado por profesionales de la salud</p>
    </div>

    <div class="process__timeline">
      {steps.map((step, index) => (
        <div class={`process__step reveal ${index % 2 !== 0 ? 'process__step--reverse' : ''}`}>
          <div class="process__step-content">
            <span class="process__step-number">{step.number}</span>
            <h3 class="process__step-title">{step.title}</h3>
            <p class="process__step-description">{step.description}</p>
          </div>

          <div class="process__step-connector">
            <div class="process__step-dot">
              <Fragment set:html={step.icon} />
            </div>
            {index < steps.length - 1 && <div class="process__step-line"></div>}
          </div>

          <div class="process__step-spacer"></div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .process__timeline {
    max-width: 900px;
    margin: 0 auto;
    position: relative;
  }

  .process__step {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: var(--space-2xl);
    align-items: start;
    margin-bottom: var(--space-xl);
  }

  .process__step--reverse .process__step-content {
    order: 3;
    text-align: left;
  }

  .process__step--reverse .process__step-spacer {
    order: 1;
  }

  .process__step-content {
    text-align: right;
    padding: var(--space-xl);
    border-radius: var(--radius-xl);
    background: var(--color-gray-50);
    border: 1px solid var(--color-gray-200);
    transition: all var(--transition-base);
  }

  .process__step-content:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
    border-color: var(--color-primary);
  }

  .process__step-number {
    display: inline-block;
    font-family: var(--font-heading);
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--color-primary);
    background: linear-gradient(135deg, rgba(245, 158, 11, 0.1), rgba(249, 115, 22, 0.05));
    padding: 0.3rem 0.8rem;
    border-radius: var(--radius-full);
    margin-bottom: var(--space-md);
  }

  .process__step-title {
    font-size: 1.3rem;
    font-weight: 700;
    margin-bottom: var(--space-sm);
    color: var(--color-gray-900);
  }

  .process__step-description {
    font-size: 0.95rem;
    color: var(--color-gray-500);
    line-height: 1.7;
  }

  /* Connector */
  .process__step-connector {
    display: flex;
    flex-direction: column;
    align-items: center;
    order: 2;
  }

  .process__step-dot {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--color-primary), var(--color-accent));
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-white);
    box-shadow: 0 4px 20px var(--color-primary-glow);
    flex-shrink: 0;
    z-index: 1;
  }

  .process__step-line {
    width: 2px;
    height: 80px;
    background: linear-gradient(to bottom, var(--color-primary), var(--color-gray-200));
    margin-top: var(--space-sm);
  }

  .process__step-spacer {
    /* Empty space for alternating layout */
  }

  /* Responsive */
  @media (max-width: 768px) {
    .process__step {
      grid-template-columns: auto 1fr;
      gap: var(--space-lg);
    }

    .process__step-content,
    .process__step--reverse .process__step-content {
      text-align: left;
      order: 2;
    }

    .process__step-connector {
      order: 1;
    }

    .process__step-spacer,
    .process__step--reverse .process__step-spacer {
      display: none;
    }

    .process__step-dot {
      width: 48px;
      height: 48px;
    }
  }

  @media (max-width: 480px) {
    .process__step-content {
      padding: var(--space-lg);
    }
  }
</style>
