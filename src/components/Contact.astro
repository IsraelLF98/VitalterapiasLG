<!-- Sección final de contacto: anima al visitante a agendar una cita -->
<section id="contacto" class="contact-section">
  <!-- Fondo decorativo: dos orbes difuminados detrás del contenido -->
  <div class="contact__bg">
    <div class="contact__orb contact__orb--1"></div>
    <div class="contact__orb contact__orb--2"></div>
  </div>

  <div class="container">
    <div class="contact reveal">
      <div class="contact__content">
        <!-- Insignia + título + subtítulo que presentan la sección -->
        <span class="section-badge" style="background: rgba(255,255,255,0.1); color: var(--color-primary-light); border-color: rgba(245, 158, 11, 0.25);">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
          Contacto
        </span>
        <h2 class="contact__title">¿Listo para transformar tu <span class="gradient-text">bienestar</span>?</h2>
        <p class="contact__subtitle">
          Agenda tu primera cita o solicita más información. Nuestro equipo de profesionales
          está listo para asesorarte y acompañarte en tu camino hacia una vida más saludable.
        </p>

        <div class="contact__buttons">
          <!-- Botón de WhatsApp: abre el chat con un mensaje predefinido
               (el ?text=... en la URL lleva el texto escrito) -->
          <a
            href="https://wa.me/593996637117?text=Hola,%20deseo%20agendar%20una%20cita%20para%20la%20Terapia%20de%20Vitamina%20C"
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-whatsapp"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            WhatsApp
          </a>
          <!-- Botón de correo: abre el cliente de email del usuario (mailto:) -->
          <a
            href="mailto:gatolic1@outlook.com"
            class="btn btn-dark"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
            Correo Electrónico
          </a>
        </div>

        <!-- 3 tarjetas de información rápida: ubicación, horarios y teléfono -->
        <div class="contact__info-grid">
          <div class="contact__info-item">
            <div class="contact__info-icon">
              <!-- Icono de pin/mapa -->
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
            </div>
            <div>
              <h4 class="contact__info-title">Ubicación</h4>
              <p class="contact__info-text">Ecuador,Quito,Calderón</p>
            </div>
          </div>
          <div class="contact__info-item">
            <div class="contact__info-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
            </div>
            <div>
              <h4 class="contact__info-title">Horarios</h4>
              <p class="contact__info-text">Lunes a Domingo: previo agendamiento</p>
            </div>
          </div>
          <div class="contact__info-item">
            <div class="contact__info-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
            </div>
            <div>
              <h4 class="contact__info-title">Teléfono</h4>
              <p class="contact__info-text">+593 99 663 7117</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Sección con gradiente oscuro (gris oscuro → marrón → gris oscuro)
     y overflow hidden para que los orbes no generen barras de scroll */
  .contact-section {
    position: relative;
    padding: var(--space-5xl) 0;
    background: linear-gradient(135deg, var(--color-gray-900) 0%, #1a1408 50%, var(--color-gray-900) 100%);
    overflow: hidden;
  }

  /* Contenedor absoluto que cubre toda la sección, detrás del contenido (z-index 0) */
  .contact__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
  }

  /* Orbes decorativos: círculos difuminados con blur para dar profundidad */
  .contact__orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(100px);
  }

  /* Orb grande ámbar arriba a la izquierda */
  .contact__orb--1 {
    width: 500px;
    height: 500px;
    background: radial-gradient(circle, rgba(245, 158, 11, 0.15), transparent 70%);
    top: -20%;
    left: -10%;
  }

  /* Orb naranja más pequeño abajo a la derecha */
  .contact__orb--2 {
    width: 400px;
    height: 400px;
    background: radial-gradient(circle, rgba(249, 115, 22, 0.1), transparent 70%);
    bottom: -20%;
    right: -5%;
  }

  .contact {
    position: relative;
    z-index: 1;
  }

  .contact__content {
    max-width: 700px;
    margin: 0 auto;
    text-align: center;
  }

  .contact__title {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 800;
    color: var(--color-white);
    margin-bottom: var(--space-lg);
    line-height: 1.2;
  }

  .contact__subtitle {
    font-size: 1.1rem;
    color: var(--color-gray-400);
    line-height: 1.8;
    margin-bottom: var(--space-2xl);
  }

  .contact__buttons {
    display: flex;
    gap: var(--space-md);
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: var(--space-3xl);
  }

  .contact__buttons .btn {
    padding: 1rem 2.2rem;
    font-size: 1.05rem;
  }

  /* Cuadrícula de información */
  /* Grid de 3 columnas iguales; cada tarjeta es una columna */
  .contact__info-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-lg);
  }

  /* Tarjeta translúcida; al pasar el cursor se aclara, se ilumina el borde
     y se eleva 4px */
  .contact__info-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-md);
    padding: var(--space-xl);
    border-radius: var(--radius-xl);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.06);
    transition: all var(--transition-base);
    text-align: center;
  }

  .contact__info-item:hover {
    background: rgba(255, 255, 255, 0.06);
    border-color: rgba(245, 158, 11, 0.2);
    transform: translateY(-4px);
  }

  .contact__info-icon {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: linear-gradient(135deg, rgba(245, 158, 11, 0.15), rgba(249, 115, 22, 0.1));
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-primary-light);
  }

  .contact__info-title {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--color-white);
  }

  .contact__info-text {
    font-size: 0.85rem;
    color: var(--color-gray-400);
  }

  /* Responsivo */
  /* En móvil: la cuadrícula pasa a 1 columna y los botones ocupan todo el ancho */
  @media (max-width: 768px) {
    .contact__info-grid {
      grid-template-columns: 1fr;
    }

    .contact__buttons .btn {
      width: 100%;
      justify-content: center;
    }
  }
</style>
