<!-- Sección principal de bienvenida: ocupa toda la pantalla (min-height: 100vh)
     y es el destino del ancla #inicio del menú. -->
<section id="inicio" class="hero">
  <!-- Elementos decorativos de fondo: orbes de colores difuminados (con blur
       en CSS) que flotan detrás del contenido y una cuadrícula muy sutil. -->
  <div class="hero__bg">
    <div class="hero__orb hero__orb--1"></div>
    <div class="hero__orb hero__orb--2"></div>
    <div class="hero__orb hero__orb--3"></div>
    <div class="hero__grid-overlay"></div>
  </div>

  <div class="hero__container container">
    <div class="hero__content">
      <!-- Columna izquierda: el texto de bienvenida. -->
      <div class="hero__text">
        <!-- Insignia superior con puntito animado (glow-pulse) que resalta
             la certificación de la terapia. -->
        <span class="hero__badge">
          <span class="hero__badge-dot"></span>
          Terapia Profesional Certificada
        </span>
        <!-- Título principal: "Vitamina C" en blanco y "Intravenosa"
             con degradado (clase global gradient-text). -->
        <h1 class="hero__title">
          Vitamina C<br/>
          <span class="gradient-text">Intravenosa</span>
        </h1>
        <p class="hero__subtitle">
          Fortalece tu sistema inmunológico, combate la fatiga y revitaliza tu organismo con nuestra terapia de alta concentración de Vitamina C administrada por profesionales.
        </p>
        <!-- Botones de acción: "Agendar Cita" abre WhatsApp y
             "Conocer más" es un ancla que baja a la sección #nosotros. -->
        <div class="hero__actions">
          <a
            href="https://wa.me/593997705273?text=Hola,%20deseo%20agendar%20una%20cita%20para%20la%20Terapia%20de%20Vitamina%20C"
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-primary"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
            Agendar Cita
          </a>
          <a href="#nosotros" class="btn btn-secondary">
            Conocer más
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
          </a>
        </div>
        <!-- Estadísticas clave: valor destacado + etiqueta, separadas
             por pequeñas líneas divisorias verticales. -->
        <div class="hero__stats">
          <div class="hero__stat">
            <span class="hero__stat-value">100%</span>
            <span class="hero__stat-label">Absorción directa</span>
          </div>
          <div class="hero__stat-divider"></div>
          <div class="hero__stat">
            <span class="hero__stat-value">30 min</span>
            <span class="hero__stat-label">Por sesión</span>
          </div>
          <div class="hero__stat-divider"></div>
          <div class="hero__stat">
            <span class="hero__stat-value">100%</span>
            <span class="hero__stat-label">Seguro y natural</span>
          </div>
        </div>
      </div>

      <!-- Columna derecha: la imagen de la terapia con un resplandor
           animado detrás y una insignia flotante de certificación. -->
      <div class="hero__visual">
        <div class="hero__image-wrapper">
          <!-- Halo de luz que pulsa detrás de la imagen (z-index 0). -->
          <div class="hero__image-glow"></div>
          <img
            src="/img/imagen.jpg"
            alt="Profesional aplicando terapia de Vitamina C Intravenosa en VitalTerapias LG"
            class="hero__image"
            loading="eager"
          />
          <!-- Badge flotante "Profesionales Certificados" superpuesto
               sobre la parte inferior de la imagen (clase glass). -->
          <div class="hero__image-badge glass">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
            <span>Profesionales Certificados</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Indicador de scroll: línea animada al pie del hero que invita
       a bajar a la siguiente sección. -->
  <div class="hero__scroll">
    <div class="hero__scroll-line"></div>
  </div>
</section>

<style>
  /* Sección hero: fondo oscuro, ocupa al menos toda la pantalla
     (100vh) y centra su contenido verticalmente. */
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    overflow: hidden;
    background: var(--color-dark);
    padding-top: var(--nav-height);
  }

  /* Decoraciones de fondo: capa absoluta detrás de todo (z-index 0)
       que contiene los orbes y la cuadrícula. */
  .hero__bg {
    position: absolute;
    inset: 0;
    overflow: hidden;
    z-index: 0;
  }

  /* Orbes: círculos con blur de 80px que simulan manchas de luz.
     Cada variante (--1, --2, --3) tiene tamaño, posición y duración
     de animación diferentes para dar profundidad. */
  .hero__orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
  }

  .hero__orb--1 {
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, rgba(245, 158, 11, 0.2), transparent 70%);
    top: -10%;
    right: -10%;
    animation: float 8s ease-in-out infinite;
  }

  .hero__orb--2 {
    width: 400px;
    height: 400px;
    background: radial-gradient(circle, rgba(249, 115, 22, 0.15), transparent 70%);
    bottom: -5%;
    left: -5%;
    animation: float 10s ease-in-out infinite reverse;
  }

  .hero__orb--3 {
    width: 300px;
    height: 300px;
    background: radial-gradient(circle, rgba(245, 158, 11, 0.1), transparent 70%);
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    animation: float 12s ease-in-out infinite;
  }

  /* Cuadrícula decorativa: líneas horizontales y verticales muy tenues
     (2% de opacidad) separadas 60px que dan textura de rejilla al fondo. */
  .hero__grid-overlay {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.02) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.02) 1px, transparent 1px);
    background-size: 60px 60px;
  }

  .hero__container {
    position: relative;
    z-index: 1;
    width: 100%;
  }

  /* Distribución en 2 columnas: texto a la izquierda, imagen a la derecha.
     gap amplio para respirar entre ambas. */
  .hero__content {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4xl);
    align-items: center;
    padding: var(--space-3xl) 0;
  }

  /* Lado del texto */
  .hero__text {
    animation: fadeInLeft 1s ease-out;
  }

  /* Insignia "Terapia Profesional Certificada": píldora translúcida
     con borde ámbar; su puntito parpadea con la animación glow-pulse. */
  .hero__badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    padding: 0.4rem 1rem;
    border-radius: var(--radius-full);
    background: rgba(245, 158, 11, 0.12);
    border: 1px solid rgba(245, 158, 11, 0.25);
    color: var(--color-primary-light);
    font-size: 0.85rem;
    font-weight: 600;
    margin-bottom: var(--space-xl);
  }

  .hero__badge-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-primary);
    animation: glow-pulse 2s ease-in-out infinite;
  }

  .hero__title {
    font-size: clamp(2.8rem, 6vw, 4.5rem);
    font-weight: 900;
    color: var(--color-white);
    line-height: 1.1;
    margin-bottom: var(--space-xl);
    letter-spacing: -0.03em;
  }

  .hero__subtitle {
    font-size: 1.15rem;
    color: var(--color-gray-400);
    line-height: 1.8;
    margin-bottom: var(--space-2xl);
    max-width: 520px;
  }

  .hero__actions {
    display: flex;
    gap: var(--space-md);
    margin-bottom: var(--space-3xl);
    flex-wrap: wrap;
  }

  /* Estadísticas: valor grande en color ámbar sobre su etiqueta gris,
     separadas por líneas divisorias verticales de 1px. */
  .hero__stats {
    display: flex;
    align-items: center;
    gap: var(--space-xl);
  }

  .hero__stat {
    display: flex;
    flex-direction: column;
  }

  .hero__stat-value {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--color-primary-light);
  }

  .hero__stat-label {
    font-size: 0.85rem;
    color: var(--color-gray-500);
    margin-top: 0.15rem;
  }

  .hero__stat-divider {
    width: 1px;
    height: 40px;
    background: rgba(255, 255, 255, 0.1);
  }

  /* Lado visual / Imagen: entra desde la derecha (fadeInRight) con un
     pequeño retraso de 0.3s para que aparezca tras el texto. */
  .hero__visual {
    display: flex;
    justify-content: center;
    animation: fadeInRight 1s ease-out 0.3s both;
  }

  .hero__image-wrapper {
    position: relative;
    max-width: 480px;
    width: 100%;
  }

  /* Resplandor detrás de la imagen: halo de luz ámbar que pulsa
     lentamente (glow-pulse de 4s). */
  .hero__image-glow {
    position: absolute;
    inset: -20px;
    background: radial-gradient(circle, var(--color-primary-glow), transparent 70%);
    border-radius: var(--radius-2xl);
    z-index: 0;
    animation: glow-pulse 4s ease-in-out infinite;
  }

  /* Imagen principal: flota suavemente (float de 6s) y está por
     encima del halo gracias al z-index. */
  .hero__image {
    position: relative;
    width: 100%;
    border-radius: var(--radius-2xl);
    box-shadow: var(--shadow-xl);
    z-index: 1;
    animation: float 6s ease-in-out infinite;
  }

  /* Badge flotante "Profesionales Certificados": centrado sobre el borde
     inferior de la imagen, con efecto de cristal esmerilado (blur). */
  .hero__image-badge {
    position: absolute;
    bottom: -16px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 2;
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    padding: 0.7rem 1.2rem;
    border-radius: var(--radius-full);
    background: rgba(15, 13, 10, 0.8);
    backdrop-filter: blur(16px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    white-space: nowrap;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-white);
  }

  /* Indicador de scroll: línea con degradado que se desvanece hacia
     abajo y flota, sugiriendo que hay más contenido al hacer scroll. */
  .hero__scroll {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 2;
  }

  .hero__scroll-line {
    width: 2px;
    height: 40px;
    background: linear-gradient(to bottom, var(--color-primary), transparent);
    border-radius: 2px;
    animation: float 2s ease-in-out infinite;
  }

  /* Responsivo */
  /* Hasta 1024px: las 2 columnas se apilan en 1 y todo el texto
     se centra; la imagen se reduce para no dominar la pantalla. */
  @media (max-width: 1024px) {
    .hero__content {
      grid-template-columns: 1fr;
      text-align: center;
      gap: var(--space-2xl);
    }

    .hero__subtitle {
      max-width: 100%;
      margin-left: auto;
      margin-right: auto;
    }

    .hero__actions {
      justify-content: center;
    }

    .hero__stats {
      justify-content: center;
    }

    .hero__image-wrapper {
      max-width: 380px;
    }
  }

  /* Hasta 768px (móviles): el hero deja de ocupar toda la pantalla,
     el título se encoge con clamp() y las estadísticas pasan de fila
     a columna con divisores horizontales. */
  @media (max-width: 768px) {
    .hero {
      min-height: auto;
      padding-top: calc(var(--nav-height) + 2rem);
      padding-bottom: 4rem;
    }

    .hero__title {
      font-size: clamp(2.2rem, 8vw, 3.5rem);
    }

    .hero__stats {
      flex-direction: column;
      gap: var(--space-md);
    }

    .hero__stat-divider {
      width: 40px;
      height: 1px;
    }

    .hero__image-wrapper {
      max-width: 300px;
    }
  }

  /* Hasta 480px (móviles pequeños): los botones se apilan a ancho
     completo para que sean fáciles de pulsar con el dedo. */
  @media (max-width: 480px) {
    .hero__actions {
      flex-direction: column;
      width: 100%;
    }

    .hero__actions .btn {
      width: 100%;
      justify-content: center;
    }
  }
</style>
