---
// Arreglo de enlaces del menú: cada elemento tiene el texto visible (label)
// y el ancla a la sección correspondiente (href, ej: #inicio).
// Se recorre con .map() más abajo para generar los <a> del menú sin repetir código.
const navLinks = [
  { label: 'Inicio', href: '#inicio' },
  { label: 'Nosotros', href: '#nosotros' },
  { label: 'Beneficios', href: '#beneficios' },
  { label: 'Proceso', href: '#proceso' },
  { label: 'Testimonios', href: '#testimonios' },
  { label: 'FAQ', href: '#faq' },
  { label: 'Contacto', href: '#contacto' },
];
---

<header class="navbar" id="navbar">
  <div class="navbar__container container">
    <!-- Logo del sitio: "Vital" en blanco y "Terapias LG" con degradado (ver CSS). -->
    <a href="#inicio" class="navbar__logo">
      Vital<span>Terapias</span> LG🍊💉
    </a>

    <!-- Botón de menú hamburguesa: oculto en escritorio (display: none en CSS)
         y visible solo en móvil. Las 3 barras se convierten en una X con .active. -->
    <button class="navbar__toggle" id="menu-toggle" aria-label="Abrir menú" aria-expanded="false">
      <span class="navbar__toggle-bar"></span>
      <span class="navbar__toggle-bar"></span>
      <span class="navbar__toggle-bar"></span>
    </button>

    <nav class="navbar__nav" id="navbar-nav">
      <!-- Los enlaces del menú se generan recorriendo navLinks con .map(). -->
      <ul class="navbar__links">
        {navLinks.map((link) => (
          <li>
            <a href={link.href} class="navbar__link">
              {link.label}
            </a>
          </li>
        ))}
      </ul>
      <!-- Botón de llamada a la acción: abre WhatsApp con un mensaje precargado. -->
      <a
        href="https://wa.me/593996637117?text=Hola,%20deseo%20agendar%20una%20cita%20para%20la%20Terapia%20de%20Vitamina%20C"
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-primary navbar__cta"
      >
        Agendar Cita
      </a>
    </nav>
  </div>
</header>

<script>
  // Referencias a los elementos del DOM que el script necesita manipular.
  const toggle = document.getElementById('menu-toggle') as HTMLButtonElement;
  const nav = document.getElementById('navbar-nav') as HTMLElement;
  const navbar = document.getElementById('navbar') as HTMLElement;
  const links = document.querySelectorAll('.navbar__link');

  // Al hacer clic en el botón hamburguesa: alterna el estado aria-expanded
  // (accesibilidad) y las clases 'active' (barras → X) y 'open' (panel móvil visible).
  toggle?.addEventListener('click', () => {
    const expanded = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!expanded));
    toggle.classList.toggle('active');
    nav.classList.toggle('open');
  });

  // Cerrar el menú al hacer clic en un enlace
  // Recorre todos los enlaces y, al pulsar uno, revierte el estado
  // del botón y oculta el panel móvil para que no quede abierto.
  links.forEach((link) => {
    link.addEventListener('click', () => {
      toggle.classList.remove('active');
      toggle.setAttribute('aria-expanded', 'false');
      nav.classList.remove('open');
    });
  });

  // Efecto de la barra de navegación al hacer scroll
  // Si scrollY supera 60px, agrega la clase 'scrolled' (fondo oscuro
  // con blur); si vuelve arriba, la elimina para dejar la navbar transparente.
  let lastScroll = 0;
  window.addEventListener('scroll', () => {
    const currentScroll = window.scrollY;

    if (currentScroll > 60) {
      navbar.classList.add('scrolled');
    } else {
      navbar.classList.remove('scrolled');
    }

    lastScroll = currentScroll;
  });
</script>

<style>
  /* Barra de navegación: fija en la parte superior (siempre visible al
     hacer scroll), transparente por defecto y por encima del resto (z-index). */
  .navbar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    padding: 1rem 0;
    transition: all var(--transition-base);
    background: transparent;
  }

  /* Estado .scrolled: se activa con JS al bajar más de 60px.
     Da fondo oscuro semitransparente con desenfoque (blur) para
     que el menú se lea bien sobre el contenido. */
  .navbar.scrolled {
    background: rgba(15, 13, 10, 0.85);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    padding: 0.6rem 0;
    box-shadow: 0 4px 30px rgba(0, 0, 0, 0.15);
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }

  .navbar__container {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  /* Logo: el span "Terapias" lleva un degradado aplicado solo al texto
     (background-clip: text) para crear el efecto de letras en dos tonos. */
  .navbar__logo {
    font-family: var(--font-heading);
    font-size: 1.6rem;
    font-weight: 800;
    color: var(--color-white);
    letter-spacing: -0.02em;
    z-index: 10;
  }

  .navbar__logo span {
    background: linear-gradient(135deg, var(--color-primary), var(--color-accent));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  /* Navegación */
  .navbar__nav {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }

  .navbar__links {
    list-style: none;
    display: flex;
    gap: var(--space-xs);
  }

  /* Enlaces del menú: texto blanco semitransparente; al pasar el cursor
     (hover) se aclaran y ganan un fondo redondeado sutil. */
  .navbar__link {
    display: block;
    padding: 0.5rem 0.85rem;
    font-size: 0.9rem;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.75);
    border-radius: var(--radius-sm);
    transition: all var(--transition-fast);
  }

  .navbar__link:hover {
    color: var(--color-white);
    background: rgba(255, 255, 255, 0.08);
  }

  .navbar__cta {
    margin-left: var(--space-sm);
    padding: 0.6rem 1.4rem;
    font-size: 0.9rem;
  }

  /* Menú hamburguesa: oculto por defecto (solo aparece en móvil).
     Con .active, cada barra se desplaza y rota para dibujar una X:
     la 1ª y la 3ª giran 45° en sentidos opuestos y la 2ª se desvanece. */
  .navbar__toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    padding: 0.5rem;
    z-index: 10;
  }

  .navbar__toggle-bar {
    display: block;
    width: 24px;
    height: 2px;
    background: var(--color-white);
    border-radius: 2px;
    transition: all var(--transition-base);
    transform-origin: center;
  }

  .navbar__toggle.active .navbar__toggle-bar:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }

  .navbar__toggle.active .navbar__toggle-bar:nth-child(2) {
    opacity: 0;
    transform: scaleX(0);
  }

  .navbar__toggle.active .navbar__toggle-bar:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* Responsivo (móvil y tablet): el menú pasa a ser un panel lateral fijo
     que entra desde la derecha (right: 0 con .open). Se muestra el botón
     hamburguesa y los enlaces se apilan en columna. */
  @media (max-width: 1024px) {
    .navbar__toggle {
      display: flex;
    }

    .navbar__nav {
      position: fixed;
      top: 0;
      right: -100%;
      width: min(320px, 85vw);
      height: 100vh;
      flex-direction: column;
      justify-content: center;
      gap: var(--space-xl);
      background: rgba(15, 13, 10, 0.97);
      backdrop-filter: blur(30px);
      -webkit-backdrop-filter: blur(30px);
      transition: right var(--transition-base);
      padding: var(--space-2xl);
    }

    .navbar__nav.open {
      right: 0;
    }

    .navbar__links {
      flex-direction: column;
      gap: var(--space-xs);
    }

    .navbar__link {
      font-size: 1.15rem;
      padding: 0.8rem 1rem;
    }

    .navbar__cta {
      margin-left: 0;
      width: 100%;
      text-align: center;
      justify-content: center;
    }
  }
</style>
